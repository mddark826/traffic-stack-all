# Copy to .env for local docker-compose runs, or set these as variables
# on the Render / Railway service. NEVER commit real keys to a public repo.

# 9Hits — dash.9hits.com -> Profile -> App Token
NINEHITS_KEY=

# Otohits — account -> App page -> Application Key
APPLICATION_KEY=

# FeelingSurf — account -> Viewer page -> Access Token
FEELINGSURF_TOKEN=

# Organic Hits — app.organichits.co -> Traffic Exchange -> Sessions -> New Key
ORGANIC_SESSION_KEY=

# Optional switches: set to "false" to disable a single viewer
ENABLE_9HITS=true
ENABLE_OTOHITS=true
ENABLE_FEELINGSURF=true
ENABLE_ORGANIC=true
